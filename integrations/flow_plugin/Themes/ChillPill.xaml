<?xml version="1.0" encoding="utf-8"?>
<!--
  ChillPill theme for Flow Launcher.

  Same palette as the shell (docs/SPEC.md §1.3) so the launcher and the pill do
  not look like two different applications sitting on top of each other:

    background  #171717      text          #dadada
    surface     #202020      muted text    #979797
    hover       #262626      dim text      #6b6b6b

  Install to %APPDATA%\FlowLauncher\Themes\ChillPill.xaml, then pick
  "ChillPill" in Flow's settings under Appearance.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:String x:Key="ThemeName">ChillPill</system:String>

    <SolidColorBrush x:Key="ChillPillBackground" Color="#171717" />
    <SolidColorBrush x:Key="ChillPillSurface" Color="#202020" />
    <SolidColorBrush x:Key="ChillPillHover" Color="#262626" />
    <SolidColorBrush x:Key="ChillPillText" Color="#dadada" />
    <SolidColorBrush x:Key="ChillPillMuted" Color="#979797" />
    <SolidColorBrush x:Key="ChillPillDim" Color="#6b6b6b" />
    <SolidColorBrush x:Key="ChillPillAccent" Color="#eecc47" />

    <Style x:Key="WindowBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource ChillPillBackground}" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="WindowStyle" TargetType="{x:Type Window}">
        <Setter Property="Width" Value="600" />
    </Style>

    <Style x:Key="QueryBoxStyle" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource ChillPillText}" />
        <Setter Property="CaretBrush" Value="{StaticResource ChillPillText}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Padding" Value="16,12,16,12" />
    </Style>

    <Style x:Key="QuerySuggestionBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource QueryBoxStyle}">
        <Setter Property="Foreground" Value="{StaticResource ChillPillDim}" />
    </Style>

    <Style x:Key="ItemTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource ChillPillText}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="ItemSubTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource ChillPillMuted}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="ItemTitleSelectedStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ItemTitleStyle}" />

    <Style x:Key="ItemSubTitleSelectedStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ItemSubTitleStyle}" />

    <Style x:Key="ItemGlyph" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource ChillPillMuted}" />
    </Style>

    <Style x:Key="ItemHotkeyStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource ChillPillDim}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="ItemHotkeySelectedStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ItemHotkeyStyle}" />

    <Style x:Key="SearchIconStyle" TargetType="{x:Type Path}">
        <Setter Property="Fill" Value="{StaticResource ChillPillMuted}" />
    </Style>

    <Style x:Key="ItemStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,8,12,8" />
    </Style>

    <Style x:Key="ItemSelectedStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ItemStyle}">
        <Setter Property="Background" Value="{StaticResource ChillPillHover}" />
    </Style>

    <Style x:Key="SeparatorStyle" TargetType="{x:Type Rectangle}">
        <Setter Property="Fill" Value="#2a2a2a" />
        <Setter Property="Height" Value="1" />
    </Style>

    <Style x:Key="ScrollBarStyle" TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="4" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

</ResourceDictionary>
